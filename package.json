{
  "name": "lifegrid",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=@lifegrid/web",
    "dev:web": "pnpm --filter @lifegrid/web dev",
    "dev:mobile": "pnpm --filter @lifegrid/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20"
  }
}
